num = 153

# Initialize sum
sum_val = 0

# Find the sum of the cube of each digit
temp = num
while temp > 0:
    digit = temp % 10
    sum_val += digit ** 3
    temp //= 10

# Display the result
if num == sum_val:
    print(f"{num} is an Armstrong number")
else:
    print(f"{num} is not an Armstrong number")

result : 153 is an Armstrong number
